#include <winver.h>
#include <winuser.h>
#include "resource.h"

IDI_APP     ICON    "Fringeless.ico"
IDR_SHADER  RCDATA  "shader.hlsl"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Fringeless.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  "Fringeless - subpixel colour-fringe correction"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "Fringeless"
      VALUE "OriginalFilename", "Fringeless.exe"
      VALUE "ProductName",      "Fringeless"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
